# --- Required ---
MAIL_API_KEY=                  # from resend.com (sender domain must be verified there)
CORS_ORIGINS=https://abordajeux.github.io

# --- Database ---
DATABASE_PATH=/app/data/abordajeux.db

# --- Programme (served by GET /schedule + auto-seeded at startup) ---
PROGRAMME_PATH=/app/data/programme.json

# --- Mail (Resend) ---
MAIL_SENDER=noreply@abordajeux.ch
MAIL_CONTACT_EMAIL=contact@abordajeux.ch
MAIL_BENEVOLE_EMAIL=             # volunteer coordinator; falls back to MAIL_CONTACT_EMAIL when empty

# --- Benevolus (joining info quoted in the volunteer welcome email) ---
BENEVOLUS_ORG_LINK=              # link to the org's join page on benevolus.ch
BENEVOLUS_TOKEN=                 # invitation token shown with the link

# --- Rate limit ---
RATE_LIMIT_SECONDS=30           # min seconds between POSTs (signup + forms) per IP

# --- Request hardening ---
MAX_BODY_BYTES=65536            # reject larger request bodies with 413 before parsing

# --- Verify link (points at the static site's verify page) ---
VERIFY_BASE_URL=https://abordajeux.github.io/presque/verify
