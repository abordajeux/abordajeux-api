# --- Required ---
ADMIN_TOKEN=                    # random string, protects /admin endpoints
BREVO_API_KEY=                  # from brevo.com free account
CORS_ORIGINS=https://abordajeux.github.io

# --- Database ---
DATABASE_PATH=/app/data/abordajeux.db

# --- Brevo ---
BREVO_SENDER=noreply@abordajeux.ch
BREVO_CONTACT_EMAIL=contact@abordajeux.ch

# --- Rate limit ---
RATE_LIMIT_SECONDS=30           # min seconds between signups per IP

# --- Verify link (points at the static site's verify page) ---
VERIFY_BASE_URL=https://abordajeux.github.io/presque/verify
